# Copy to .env and fill in. Never commit .env.

# Vapi dashboard -> API Keys
VAPI_API_KEY=
VAPI_PUBLIC_KEY=

# Filled in on Day 2 once the assistant exists
VAPI_ASSISTANT_ID=
# Only needed for CALL_MODE=phone
VAPI_PHONE_NUMBER_ID=

# web (browser call via Vapi Web SDK) | phone (real outbound call)
CALL_MODE=web

# Public ngrok URL Vapi sends webhooks to, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Demo time speedup: 10 means 1 real second = 10 simulated seconds
TIME_SPEEDUP=1

DATABASE_PATH=relay.db

# Your own phone in E.164 (e.g. +15551234567). Every seed order uses it. Only call numbers you own.
DEMO_CUSTOMER_PHONE=
